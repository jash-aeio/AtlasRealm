{
  "name": "atlas-realm",
  "version": "0.1.0",
  "description": "Local-first Windows desktop app where projects are buildings in a fantasy isometric world.",
  "author": "jash-aeio",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "package": "electron-vite build && node scripts/electron-builder.ts --win --publish never",
    "package:test": "electron-vite build && node scripts/electron-builder.ts --win dir --publish never -c.directories.output=release-test -c.appId=io.github.jash-aeio.atlasrealm.test -c.productName=AtlasRealmTest -c.extraMetadata.productName=AtlasRealmTest -c.win.executableName=AtlasRealmTest -c.extraMetadata.atlasRealm.packagedTest=true",
    "test:e2e:packaged": "playwright test --config playwright.packaged.config.ts",
    "art:placeholders": "node scripts/generate-placeholder-art.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@xyflow/react": "12.12.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "pixi.js": "8.22.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "main": "out/main/index.js"
}
