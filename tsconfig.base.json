{
  // Shared compiler options. tsconfig.node.json and tsconfig.web.json extend this file.
  "compilerOptions": {
    // Language and modules. electron-vite bundles the output, so tsc only type-checks.
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    // Type safety. `strict` turns on the whole family (strictNullChecks, noImplicitAny, ...).
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true
  }
}
