{
  // Playwright E2E tests: the test runs in Node, but page.evaluate() callbacks run in the
  // renderer, so these files need both Node and DOM types (plus window.atlas).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["tests/e2e", "src/renderer/env.d.ts"]
}
