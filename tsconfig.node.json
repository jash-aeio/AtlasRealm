{
  // Code that runs in Node/Electron: main process, preload, worker, shared contracts, tests, configs.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "src/main",
    "src/preload",
    "src/worker",
    "src/common",
    "tests",
    "scripts",
    "*.config.ts"
  ],
  "exclude": ["tests/e2e", "tests/e2e-packaged"]
}
